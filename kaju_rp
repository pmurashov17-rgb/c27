-- +1 BACKFLIP FOR BRAINROTS - MINIMAL (NO GUI, NO KEY)
-- Управление: Q/ПКМ - бэкфлип, F1-F6 - функции, или !команды в чате

local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

-- Переменные
local brainrotLevel = 0
local money = 0
local flyEnabled = false
local flySpeed = 50
local infiniteJump = false
local flipCooldown = false
local bodyVelocity = nil
local bodyGyro = nil

-- Конфиг
local CONFIG = {
    FlipDuration = 0.5,
    JumpPower = 14,
    AutoFlip = true,
    FallSpeed = -18
}

-- Бэкфлип
local function doBackflip()
    if flipCooldown or not humanoid or humanoid.Health <= 0 then return end
    flipCooldown = true
    humanoid.PlatformStand = true
    rootPart.Velocity = Vector3.new(rootPart.Velocity.X, CONFIG.JumpPower, rootPart.Velocity.Z)
    
    local t = 0
    local duration = CONFIG.FlipDuration
    local startRot = rootPart.Orientation.X
    local conn
    conn = game:GetService("RunService").Heartbeat:Connect(function(dt)
        t = t + dt
        if t >= duration then
            rootPart.Orientation = Vector3.new(startRot + 360, rootPart.Orientation.Y, rootPart.Orientation.Z)
            humanoid.PlatformStand = false
            flipCooldown = false
            conn:Disconnect()
            return
        end
        rootPart.Orientation = Vector3.new(startRot + 360 * (t / duration), rootPart.Orientation.Y, rootPart.Orientation.Z)
    end)
    
    brainrotLevel = brainrotLevel + 1
    money = money + 5
    print("🧠 +1 Brainrot | 💰 +$5")
end

-- Бесконечные деньги
local function setInfiniteMoney()
    money = 999999999
    print("💰 Бесконечные деньги: $" .. money)
end

-- Бесконечные прыжки
local function toggleInfiniteJump()
    infiniteJump = not infiniteJump
    if infiniteJump then
        humanoid.UseJumpPower = true
        humanoid.JumpPower = 300
        print("🚀 Бесконечные прыжки ВКЛ")
    else
        humanoid.JumpPower = CONFIG.JumpPower
        print("🚀 Бесконечные прыжки ВЫКЛ")
    end
end

-- Кража Brainrot
local function stealBrainrot()
    local stolen = 0
    for _, otherPlayer in ipairs(game.Players:GetPlayers()) do
        if otherPlayer ~= player then
            local success, val = pcall(function()
                return otherPlayer:GetAttribute("Brainrot") or 0
            end)
            if success then
                local amount = math.floor(val * 0.5) + 2
                brainrotLevel = brainrotLevel + amount
                money = money + amount * 5
                stolen = stolen + amount
                otherPlayer:SetAttribute("Brainrot", math.max(0, val - amount))
            else
                brainrotLevel = brainrotLevel + 3
                money = money + 15
                stolen = stolen + 3
            end
        end
    end
    print("💀 Украдено Brainrot: " .. stolen)
end

-- Спавн ULTIMATE Brainrot
local function spawnUltimateBrainrot()
    local basePos = rootPart.Position + Vector3.new(0, 5, 0)
    for i = 1, 20 do
        local part = Instance.new("Part")
        part.Size = Vector3.new(5, 5, 5)
        part.Position = basePos + Vector3.new(math.random(-30, 30), math.random(1, 10), math.random(-30, 30))
        part.BrickColor = BrickColor.new("Bright yellow")
        part.Material = Enum.Material.Neon
        part.Anchored = true
        part.Parent = workspace
        
        local clickDetector = Instance.new("ClickDetector")
        clickDetector.Parent = part
        clickDetector.MouseClick:Connect(function(plr)
            if plr == player then
                brainrotLevel = brainrotLevel + 50
                money = money + 250
                part:Destroy()
                print("🔥 +50 ULTIMATE BRAINROT!")
            end
        end)
        
        local highlight = Instance.new("Highlight")
        highlight.Parent = part
        highlight.FillColor = Color3.new(1, 0.8, 0)
        highlight.FillTransparency = 0.3
        highlight.OutlineColor = Color3.new(1, 0, 0)
        
        spawn(function()
            while part.Parent do
                part.Position = part.Position + Vector3.new(0, math.sin(tick() * 2 + i) * 0.05, 0)
                task.wait(0.05)
            end
        end)
    end
    print("⭐ Спавн ULTIMATE BRAINROT завершён! (нажми на жёлтые кубы)")
end

-- Полет
local function toggleFly()
    flyEnabled = not flyEnabled
    if flyEnabled then
        humanoid.PlatformStand = true
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 4000
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        bodyVelocity.Parent = rootPart
        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(1, 1, 1) * 4000
        bodyGyro.Parent = rootPart
        print("✈️ Полет ВКЛ (WASD + Space/Shift)")
    else
        if bodyVelocity then bodyVelocity:Destroy() end
        if bodyGyro then bodyGyro:Destroy() end
        humanoid.PlatformStand = false
        print("✈️ Полет ВЫКЛ")
    end
end

-- Кикнуть игрока
local function kickPlayer()
    local targets = {}
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= player then table.insert(targets, p) end
    end
    if #targets == 0 then print("Нет других игроков") return end
    local target = targets[math.random(1, #targets)]
    if target.Character then
        target.Character:BreakJoints()
        print("🔨 Игрок " .. target.Name .. " кикнут (удалён персонаж)")
    else
        print("У игрока нет персонажа")
    end
end

-- Краш сервера (имитация)
local function crashServer()
    print("⚠️ ЗАПУСК КРАША (может вызвать лаг)")
    for i = 1, 1000 do
        local part = Instance.new("Part")
        part.Size = Vector3.new(1, 1, 1)
        part.Position = Vector3.new(math.random(-500, 500), math.random(-500, 500), math.random(-500, 500))
        part.Anchored = true
        part.Material = Enum.Material.Neon
        part.BrickColor = BrickColor.random()
        part.Parent = workspace
        game:GetService("Debris"):AddItem(part, 0.1)
    end
    print("💥 Краш-спам запущен!")
end

-- Обновление полета (сердцебиение)
game:GetService("RunService").Heartbeat:Connect(function()
    if flyEnabled and bodyVelocity and rootPart then
        local moveDirection = Vector3.new(0, 0, 0)
        local uis = game:GetService("UserInputService")
        if uis:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + rootPart.CFrame.LookVector * flySpeed end
        if uis:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - rootPart.CFrame.LookVector * flySpeed end
        if uis:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - rootPart.CFrame.RightVector * flySpeed end
        if uis:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + rootPart.CFrame.RightVector * flySpeed end
        if uis:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0, flySpeed, 0) end
        if uis:IsKeyDown(Enum.KeyCode.LeftShift) then moveDirection = moveDirection - Vector3.new(0, flySpeed, 0) end
        bodyVelocity.Velocity = moveDirection
        if bodyGyro then bodyGyro.CFrame = rootPart.CFrame end
    end
end)

-- Управление клавишами (ПК)
game:GetService("UserInputService").InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 or input.KeyCode == Enum.KeyCode.Q then
        doBackflip()
    end
    if input.KeyCode == Enum.KeyCode.F1 then toggleInfiniteJump() end
    if input.KeyCode == Enum.KeyCode.F2 then toggleFly() end
    if input.KeyCode == Enum.KeyCode.F3 then stealBrainrot() end
    if input.KeyCode == Enum.KeyCode.F4 then spawnUltimateBrainrot() end
    if input.KeyCode == Enum.KeyCode.F5 then crashServer() end
    if input.KeyCode == Enum.KeyCode.F6 then kickPlayer() end
    if input.KeyCode == Enum.KeyCode.F7 then setInfiniteMoney() end
end)

-- Автофлип при падении
if CONFIG.AutoFlip then
    character.Humanoid.StateChanged:Connect(function(old, new)
        if new == Enum.HumanoidStateType.Falling then
            task.wait(0.2)
            if rootPart.Velocity.Y < CONFIG.FallSpeed then
                doBackflip()
            end
        end
    end)
end

-- Сброс при респавне
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = newChar:WaitForChild("Humanoid")
    rootPart = newChar:WaitForChild("HumanoidRootPart")
    flipCooldown = false
    flyEnabled = false
    if bodyVelocity then bodyVelocity:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end
end)

-- Команды чата
game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents.SayMessageRequest:Connect(function(msg)
    local cmd = msg:lower()
    if cmd == "!flip" then doBackflip()
    elseif cmd == "!money" then setInfiniteMoney()
    elseif cmd == "!jump" then toggleInfiniteJump()
    elseif cmd == "!steal" then stealBrainrot()
    elseif cmd == "!spawn" then spawnUltimateBrainrot()
    elseif cmd == "!fly" then toggleFly()
    elseif cmd == "!crash" then crashServer()
    elseif cmd == "!kick" then kickPlayer()
    elseif cmd == "!brain" then print("🧠 Brainrot: " .. brainrotLevel .. " | 💰 Money: $" .. money)
    end
end)

print("🧠 MINIMAL MOD ЗАГРУЖЕН (БЕЗ ОКОН)")
print("🔄 Q/ПКМ - флип | F1-прыжки | F2-полет | F3-кража | F4-спавн | F5-краш | F6-кик | F7-деньги")
print("💬 !flip, !jump, !fly, !steal, !spawn, !crash, !kick, !money, !brain")
